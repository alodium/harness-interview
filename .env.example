# Private Answer Keys (Production / Vercel)
# Upload private_data/answer_keys.json to a Private GitHub Gist and set:
# ANSWER_KEYS_URL="https://api.github.com/gists/<YOUR_GIST_ID>"
# (or the raw Gist URL: https://gist.githubusercontent.com/<user>/<id>/raw/answer_keys.json)
# GITHUB_TOKEN="github_pat_..."  # Fine-grained PAT with Read-only access to Gists

# Neon Serverless Postgres (optional locally; logs submissions, pass rates & waitlist leads)
# DATABASE_URL="postgresql://user:pass@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
